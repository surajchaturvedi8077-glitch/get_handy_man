# ------------------------------------------------------------------
# Get Handyman frontend — environment variables
# Copy to ".env" and fill in. In dev, VITE_API_URL can be left blank
# since vite.config.js proxies /api to the backend automatically.
# ------------------------------------------------------------------

# Base URL of the backend API. Leave blank in dev (uses the proxy).
# In production, point this at your deployed API, e.g.
# VITE_API_URL=https://api.gethandyman.com.au
VITE_API_URL=
