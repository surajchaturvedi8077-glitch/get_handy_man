          <JobListItem key={job._id} job={job} />
        ))}
        {todaysJobs.length === 0 && (
          <Text style={styles.emptyText}>No jobs scheduled for today.</Text>
        )}
      </ScrollView>
    </View>
  );
}

const styles = StyleSheet.create({
