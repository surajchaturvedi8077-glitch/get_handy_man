import SegmentedControl from '../ui/SegmentedControl';

const OPTIONS = [
  { value: 'new', label: 'New' },
  { value: 'quoted', label: 'Quoted' },
  { value: 'accepted', label: 'Accepted' },
  { value: 'all', label: 'All' },
